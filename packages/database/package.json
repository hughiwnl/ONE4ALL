{
  "name": "@repeat/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "node scripts/with-env.mjs prisma migrate dev",
    "migrate:deploy": "node scripts/with-env.mjs prisma migrate deploy",
    "migrate:reset": "node scripts/with-env.mjs prisma migrate reset --force",
    "studio": "node scripts/with-env.mjs prisma studio",
    "seed": "node scripts/with-env.mjs tsx src/seed.ts",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "prisma": "^6.19.3"
  },
  "devDependencies": {
    "tsx": "^4.23.13"
  }
}
