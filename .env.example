# ──────────────────────────────────────────────────────────────────────────────
# Repeat configuration
#
#   cp .env.example .env
#
# Values marked REQUIRED must be set. Everything else has a sensible default.
# When running with `docker compose up`, the database/redis hosts below already
# point at the compose services.
# ──────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
LOG_LEVEL=info

# ── Core infrastructure ───────────────────────────────────────────────────────
# REQUIRED. Docker Compose uses the "db" and "redis" service names; for local
# `pnpm dev` against the compose services use localhost instead.
DATABASE_URL=postgresql://repeat:repeat@localhost:5432/repeat
REDIS_URL=redis://localhost:6379

# Credentials for the Postgres container (docker compose only).
POSTGRES_USER=repeat
POSTGRES_PASSWORD=repeat
POSTGRES_DB=repeat

# ── Application ───────────────────────────────────────────────────────────────
# REQUIRED. The public URL of this instance. Used for OAuth redirect URIs and
# for the media URLs Instagram downloads from, so it must be reachable from the
# internet (HTTPS) for Instagram publishing and real OAuth providers.
APP_URL=http://localhost:3000

# REQUIRED. Random string of at least 32 characters. Generate with:
#   openssl rand -base64 48
SESSION_SECRET=

# REQUIRED. 32-byte key (base64 or hex) used to encrypt stored OAuth tokens.
# Generate with:
#   openssl rand -base64 32
# Losing or changing this key makes every stored token unreadable (accounts
# must be reconnected).
TOKEN_ENCRYPTION_KEY=

# Allow new users to sign up after the first account exists. Set to false on a
# public server once you have created your user(s).
ALLOW_REGISTRATION=true

# ── Media storage ─────────────────────────────────────────────────────────────
# "local" stores uploads on disk under MEDIA_STORAGE_PATH (a Docker volume in
# compose). S3-compatible drivers can be added behind the same interface.
MEDIA_STORAGE_DRIVER=local
MEDIA_STORAGE_PATH=./data/media
MAX_UPLOAD_SIZE_MB=2048
# Optional: explicit path to ffprobe (auto-detected on PATH when unset).
# FFPROBE_PATH=/usr/bin/ffprobe

# ── Worker ────────────────────────────────────────────────────────────────────
# Number of destinations one worker process publishes concurrently.
WORKER_CONCURRENCY=2

# ── YouTube (Google) ──────────────────────────────────────────────────────────
# Optional. Leave empty to run without YouTube. See docs/providers.md and the
# README for how to create these in Google Cloud Console. The OAuth redirect
# URI to register is: ${APP_URL}/api/connect/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Facebook Pages + Instagram (Meta) ─────────────────────────────────────────
# Optional. Leave empty to run without Meta platforms. The OAuth redirect URI
# to register is: ${APP_URL}/api/connect/meta/callback
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v21.0

# ── Development ───────────────────────────────────────────────────────────────
# Registers a fake "mock" platform that simulates uploads, processing and
# failures so the whole pipeline can be exercised without real credentials.
# Nothing is ever published anywhere. Handy for a first run; turn it off on a
# real deployment.
MOCK_PROVIDER_ENABLED=false
